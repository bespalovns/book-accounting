<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/authorsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DCEBD5"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Авторы"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/authorFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Новый автор"
            android:textColor="#000000"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/authorLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Фамилия"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="100"
            android:singleLine="true"
            android:textColor="#000000"
            android:textColorHint="#52634F" />

        <EditText
            android:id="@+id/authorFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Имя"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="100"
            android:singleLine="true"
            android:textColor="#000000"
            android:textColorHint="#52634F" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/saveAuthorButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Сохранить"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#426E52" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/clearAuthorButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Новый автор"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#426E52" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/deleteAuthorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Удалить выбранного автора"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            app:backgroundTint="#426E52" />

        <TextView
            android:id="@+id/authorsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFF5CF"
            android:padding="10dp"
            android:text="Загрузка…"
            android:textColor="#000000" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/refreshAuthorsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Обновить список"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:backgroundTint="#426E52" />

    </LinearLayout>

    <ListView
        android:id="@+id/authorsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFEF5"
        android:divider="#D5E3D2"
        android:dividerHeight="1dp" />

</LinearLayout>